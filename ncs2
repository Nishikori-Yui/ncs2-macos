#!/bin/zsh
set -euo pipefail
ROOT_DIR="${0:A:h}"
action="${1:-help}"
(( $# == 0 )) || shift
logger="$ROOT_DIR/ncs2_log_run.sh"
case "$action" in
  fetch) exec /bin/zsh "$logger" "校验/准备锁定依赖" python3 "$ROOT_DIR/scripts/bootstrap.py" "$@" ;;
  build) exec /bin/zsh "$logger" "构建 macOS arm64 runtime 和工具" /bin/zsh "$ROOT_DIR/scripts/build_runtime.sh" "$@" ;;
  build-probe) exec /bin/zsh "$logger" "编译 arm64 probe" /bin/zsh "$ROOT_DIR/scripts/build_probe.sh" "$@" ;;
  build-swift) exec /bin/zsh "$logger" "编译 arm64 Swift 客户端" /bin/zsh "$ROOT_DIR/scripts/build_swift_clients.sh" "$@" ;;
  check) exec /bin/zsh "$logger" --stream "验证 arm64 依赖闭包" /bin/zsh "$ROOT_DIR/scripts/check_arm64.sh" "$@" ;;
  reproduce) exec /bin/zsh "$logger" "从源码快照和全新依赖复现 macOS 工具链" python3 "$ROOT_DIR/scripts/reproduce_macos.py" "$@" ;;
  usb) exec /bin/zsh "$logger" "读取 USB 描述符" python3 "$ROOT_DIR/read_ncs2_usb.py" "$@" ;;
  suite) exec /bin/zsh "$logger" "算子与 IR 实验套件" python3 "$ROOT_DIR/scripts/run_suite.py" "$@" ;;
  xlink) exec /bin/zsh "$logger" "固定 runtime XLink 事件观察" python3 "$ROOT_DIR/scripts/trace_xlink.py" "$@" ;;
  trace) exec /bin/zsh "$logger" "USB 固件启动和推理生命周期观察" python3 "$ROOT_DIR/scripts/trace_lifecycle.py" "$@" ;;
  perf) exec /bin/zsh "$logger" "并发吞吐和主机预处理实验" python3 "$ROOT_DIR/scripts/run_perf.py" "$@" ;;
  soak) exec /bin/zsh "$logger" "worker 长跑与进程恢复实验" python3 "$ROOT_DIR/scripts/worker_soak.py" "$@" ;;
  worker) exec /bin/zsh "$logger" --stream "启动常驻 JSON worker" "$ROOT_DIR/build-arm64/ncs2_worker" "$ROOT_DIR/vendor/openvino-2022.3/bin/arm64/Release/plugins.xml" "$@" ;;
  package) exec /bin/zsh "$logger" "构建仅本地可搬移 runtime" python3 "$ROOT_DIR/scripts/package_runtime.py" "$@" ;;
  source-export) exec /bin/zsh "$logger" "导出公开源码候选" python3 "$ROOT_DIR/scripts/export_source.py" "$@" ;;
  apps) exec /bin/zsh "$logger" "无摄像头音频和时序应用实验" python3 "$ROOT_DIR/scripts/run_apps.py" "$@" ;;
  multi-io) exec /bin/zsh "$logger" "静态多端口 MYRIAD 实验" "$ROOT_DIR/build-arm64/ncs2_multi_io" "$ROOT_DIR/vendor/openvino-2022.3/bin/arm64/Release/plugins.xml" "$@" ;;
  multi-worker) exec /bin/zsh "$logger" --stream "schema 2 多输入多输出 worker" "$ROOT_DIR/build-arm64/ncs2_multi_worker" "$ROOT_DIR/vendor/openvino-2022.3/bin/arm64/Release/plugins.xml" "$@" ;;
  multi-worker-demo) exec /bin/zsh "$logger" "schema 2 多张量 worker 实验" python3 "$ROOT_DIR/scripts/multi_worker_demo.py" "$@" ;;
  list|smoke|bench) exec /bin/zsh "$logger" "MYRIAD $action" /bin/zsh "$ROOT_DIR/scripts/run_probe.sh" "$action" "$@" ;;
  help|--help|-h)
    print -- "ncs2: native arm64 macOS experiments (commands append the local notebook)"
    print -- "  fetch [--offline]  Fetch pinned inputs, or verify local files only"
    print -- "  build              Configure/build pinned runtime and probe"
    print -- "  build-probe        Recompile the native C++ tools"
    print -- "  build-swift        Build arm64 SwiftPM library, tests, and demos"
    print -- "  check [--json]     Verify arm64 dependencies; optional JSON inventory"
    print -- "  reproduce [options] Fresh online inputs/build and offline tests; no USB"
    print -- "  usb [--show-serial] Read descriptors; serial hidden by default"
    print -- "      --parse-configuration-hex HEX|@PATH Parse saved config offline"
    print -- "  list               Ask MYRIAD for available device IDs"
    print -- "  smoke              Boot official firmware if needed; run/verify ReLU"
    print -- "  bench [N] [warmup] Verified alternating-input ReLU timings (100/10)"
    print -- "  suite [options]    IR/operator/shape tests; use --help for bounded cases"
    print -- "  xlink [options]    Runtime stream/FIFO/trigger debug observations"
    print -- "  trace [options]    Passive USB sampling around explicit boot/inference"
    print -- "  perf [options]     Async depth and host/device preprocessing experiments"
    print -- "  soak [options]     Bounded worker soak, RSS samples, and restart recovery"
    print -- "  worker --case ID | --model XML  Persistent JSON-lines worker"
    print -- "  apps --hardware | --cpu-only   Offline WAV and time-series demos"
    print -- "  multi-io [--case ID] [--export DIR]  Export/reload or verify a multi-port graph"
    print -- "      cases: add-sub (default) | concat-unequal | split-halves"
    print -- "  multi-worker --model XML  Run the schema-2 multi-tensor worker"
    print -- "  multi-worker-demo --model XML [--case ID]  Check a schema-2 fixture"
    print -- "  package [options]  Local-only relocatable runtime (not a release)"
    print -- "  source-export      Allowlisted source candidate; no vendor/binaries/logs"
    ;;
  *) print -u2 -- "Unknown command: $action (use ./ncs2 help)"; exit 64 ;;
esac
